---
interface Props {
  title: string;
  description: string;
  url: string;
  author?: string;
  source?: string;
  date?: Date;
  tags?: string[];
}

const { title, description, url, author, source, date, tags = [] } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('hr-HR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article class="card">
  <div class="card-meta">
    {source && <span class="card-source">{source}</span>}
    {date && <time class="card-date" datetime={date.toISOString()}>{fmt(date)}</time>}
  </div>
  <h3 class="card-title">
    <a href={url}>{title}</a>
  </h3>
  <p class="card-desc">{description}</p>
  {author && <p class="card-author">{author}</p>}
  {tags.length > 0 && (
    <ul class="card-tags" role="list">
      {tags.map((t) => <li class="tag">{t}</li>)}
    </ul>
  )}
</article>

<style>
  .card {
    border: 1px solid var(--line);
    background: var(--paper-raised);
    border-radius: var(--radius);
    padding: 1.35rem 1.5rem;
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .card-meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .card-source {
    color: var(--accent);
    font-weight: 600;
  }

  .card-date {
    color: var(--ink-faint);
  }

  .card-title {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.35;
  }

  .card-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--accent);
  }

  .card-desc {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-author {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .card-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.35rem 0 0;
    padding: 0;
  }

  .tag {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
</style>
