---
import '../styles/global.css';
import FontSetup from '../components/FontSetup.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Čitaona — osobna biblioteka', description = 'Osobna biblioteka tekstova i kolumni' } = Astro.props;
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <FontSetup />
    <title>{title}</title>
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = stored ?? (dark ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Preskoči na sadržaj</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Početna — Čitaona">
          <span class="brand-mark" aria-hidden="true">❋</span>
          <span class="brand-name">Čitaona</span>
        </a>
        <nav class="site-nav" aria-label="Glavna navigacija">
          <a href="/" class="nav-link">Polica</a>
          <a href="/o-citaoni/" class="nav-link">O čitaoni</a>
        </nav>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Promijeni temu"
          title="Promijeni temu"
        >
          <span class="icon-sun" aria-hidden="true">☀</span>
          <span class="icon-moon" aria-hidden="true">☾</span>
        </button>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>Osobna čitaona — tekstovi koje vrijedi pročitati dvaput.</p>
      </div>
    </footer>
    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme;
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
