---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const texts = await getCollection('texts');
  return texts.map((t) => ({ params: { slug: t.id }, props: { text: t } }));
}

const { text } = Astro.props;
const { Content } = await render(text);
const fmt = (d: Date) =>
  d.toLocaleDateString('hr-HR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={`${text.data.title} — Čitaona`} description={text.data.description}>
  <article class="prose">
    <header class="article-header">
      {text.data.source && <p class="article-source">{text.data.source}</p>}
      <h1>{text.data.title}</h1>
      <p class="article-meta">
        {text.data.author && <span class="article-author">{text.data.author}</span>}
        {text.data.author && text.data.date && <span aria-hidden="true"> · </span>}
        {text.data.date && <time datetime={text.data.date.toISOString()}>{fmt(text.data.date)}</time>}
      </p>
      {text.data.tags && text.data.tags.length > 0 && (
        <ul class="article-tags" role="list">
          {text.data.tags.map((tag: string) => <li>{tag}</li>)}
        </ul>
      )}
    </header>
    <Content />
    <footer class="article-footer">
      {text.data.originalUrl && (
        <p class="original-link">
          Izvorno objavljeno: <a href={text.data.originalUrl} rel="noopener">{text.data.originalUrl}</a>
        </p>
      )}
      <a href="/">← Natrag na policu</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .article-source {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .article-meta {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 0.5rem 0 0;
  }

  .article-author {
    font-weight: 600;
  }

  .article-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
  }

  .article-tags li {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  .article-footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .original-link {
    margin: 0;
    color: var(--ink-faint);
    word-break: break-all;
  }
</style>
