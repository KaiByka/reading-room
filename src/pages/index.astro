---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SearchFilter from '../components/SearchFilter.astro';
import { getCollection } from 'astro:content';

const texts = (await getCollection('texts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const items = texts.map((t) => ({
  title: t.data.title,
  description: t.data.description,
  url: `/tekstovi/${t.id}/`,
  author: t.data.author,
  source: t.data.source,
  tags: t.data.tags,
}));
---

<BaseLayout>
  <section class="hero">
    <h1>Polica</h1>
    <p class="hero-sub">
      Tekstovi i kolumne koje vrijedi pročitati još jednom — sačuvani za sebe.
    </p>
  </section>

  <SearchFilter items={items}>
    {texts.map((t) => (
      <ArticleCard
        title={t.data.title}
        description={t.data.description}
        url={`/tekstovi/${t.id}/`}
        author={t.data.author}
        source={t.data.source}
        date={t.data.date}
        tags={t.data.tags}
      />
    ))}
  </SearchFilter>
</BaseLayout>

<style>
  .hero {
    padding-top: 3.5rem;
    max-width: 42rem;
  }

  .hero h1 {
    font-size: 2.6rem;
    margin: 0 0 0.5rem;
  }

  .hero-sub {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.1rem;
  }
</style>
